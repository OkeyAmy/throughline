# ===========================================================================
# Deep .gitignore for the "applicathon" / throughline hackathon project
# Python backend (FastAPI) + React/Vite web frontend + HydraDB graph service
# ===========================================================================

# ---------------------------------------------------------------------------
# Local environment & secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.env.local
.env.development
.env.staging
.env.production
.env.test
.env.debug

# Private deployment / runtime state
.hydradb/
.hydra/
.remember/          # agent memory logs & tmp (do not commit session state)
.repos/             # cloned external repositories for diffing
data/               # local data ingested into HydraDB
web/dist/           # built web bundle (committed via Dockerfile COPY only)
web/.tmp/
web/.vite/
web/.vite-temp/
node_modules/
.pnpm/
.pnpm-store/
.pnpm-store-v3/

# ---------------------------------------------------------------------------
# Python: bytecode, caches, build, packaging
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.cpython-*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
eggs/
wheels/
*.whl

# Virtual environments (multiple naming conventions)
.venv/
venv/
env/
ENV/
.ve/
env.bak/
venv.bak/

# Test & lint artefacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.nox/
.tox/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.dmypy.json
dmypy.json
.pytest_cache
.cache
pip-wheel-metadata/

# Jupyter / interactive
.ipynb_checkpoints/
profile_default/
ipython_config.py
jupyter_notebook_config.py

# PyInstaller (bundles everything into one file)
*.manifest
*.spec

# ---------------------------------------------------------------------------
# Node.js / package managers
# ---------------------------------------------------------------------------
node_modules/
.web_modules/
.file-tree-cache/
.npm
.yarn/
.yarn-integrity.yml
.yarn-debug-*
.yarn-error-*
.pnpm-debug-*
.yarn-patch/
.npm-debug.log*
yarn-debug-*
yarn-error-*
npm-debug.log*
yarn.lock
package-lock.json
.pnp.cjs
.pnp.loader.mjs
.webpack/
.eslintcache
.prettiercache
.svelte-kit/
.parcel-cache/

# Vite / build output (also ignored per-web dir, but catch globally)
.vite/
.rollup.cache/
.astro/
.out/
.nuxt/
.svelte-kit/
.next/
dist/
dist-*.js
tmp/
temp/

# TypeScript
*.tsbuildinfo

# ---------------------------------------------------------------------------
# HydraDB & evaluation harness runtime artefacts
# ---------------------------------------------------------------------------
registry.json                       # large generated graph registry, regen via loader
eval_harness/.embed-index.json      # large embedding index (regenerate offline)
eval_harness/.cache/
eval_harness/embeddings/
eval_harness/vectors/
eval_harness/*.jsonl
eval_harness/.artefacts/
eval_harness/output/

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.override.yaml
docker-compose.local.yml
docker-compose.dev.yml
docker-compose.prod.yml
.dockerignore
.docker/

# ---------------------------------------------------------------------------
# IDEs & editors
# ---------------------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace

# JetBrains / IntelliJ
.idea/
*.iml
*.iws
*.ipr
.idea-modules/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom / Wallaby
.wallaby*

# Emacs / Vim / Nano (swap, lock, backup files)
*~
\#*\#
.\#*
*.swp
*.swo
*.swn
*.tmp
*.bak
*.save

# Zed
.zed/

# Cursor
.cursor/
.cursorindexing/
.cursor-*

# GitHub Copilot
.copilot/

# Kiro
.kiro/

# Generic / misc editor dirs
.history/
.cproject
.classpath
.factorypath
.settings/
.pydev/
.vs/

# ---------------------------------------------------------------------------
# OS / filesystem cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs_vista.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
*$RECYCLE.BIN*
*.cab
*.msi
*.msm
*.msp
.AppleDouble
.LSOverride
Icon?
.SymLink*

# macOS AppleDouble
.AppleDouble

# ---------------------------------------------------------------------------
# Logs & tmp
# ---------------------------------------------------------------------------
*.log
logs/
log/
nohup.out
*.out
*.pid
*.session

# ---------------------------------------------------------------------------
# Secrets & credentials (belt & suspenders — never commit)
# ---------------------------------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
id_ecdsa*
*.gpg
*.asc
credentials/
secrets/
.secret/
api_keys/
.keys/

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# Hugo (if a docs site is ever added)
/resources/_gen/
/public/
/hugo_stats.json

# Sphinx docs
_build/
_doctrees/

# Terraform
.terraform/
.terraform.tfstate*
crash.log
crash.*.log

# SQLite / local db files
*.db
*.sqlite
*.sqlite3
*.db-journal
