# Local secrets. Gitignored — never commit this file.
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Chat model: symbol resolution from a question, answer text, eval judge.
# Verified working. Plain instruct model — its reply lands in message.content.
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
# Reasoning alternative. Verified working, but it returns its answer in
# message.reasoning_content unless you pass chat_template_kwargs={"thinking": false}.
NVIDIA_REASONING_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# Embedding model for the RAG baseline the graph is measured against (eval only).
# Verified: 2048 dimensions, requires input_type="query"|"passage" on every call.
NVIDIA_EMBED_MODEL=nvidia/llama-nemotron-embed-1b-v2
HYDRADB_URL=http://127.0.0.1:8443
HYDRADB_TOKEN=local-development-token-32-bytes
THROUGHLINE_WORKERS=6
